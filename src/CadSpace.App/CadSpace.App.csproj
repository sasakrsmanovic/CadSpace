<Project Sdk="Uno.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0-desktop;net10.0-browserwasm</TargetFrameworks>
    <OutputType>Exe</OutputType><UnoSingleProject>true</UnoSingleProject><IsPackable>false</IsPackable>
    <ApplicationTitle>CadSpace</ApplicationTitle><ApplicationId>org.cadspace.studio</ApplicationId>
    <ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion><ApplicationVersion>1</ApplicationVersion>
    <ApplicationPublisher>CadSpace contributors</ApplicationPublisher>
    <UnoFeatures>SkiaRenderer;GLCanvas;</UnoFeatures><AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <WasmShellWebAppBasePath>./</WasmShellWebAppBasePath><WasmShellILLinkerEnabled>false</WasmShellILLinkerEnabled><PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../CadSpace.Controls/CadSpace.Controls.csproj" />
    <ProjectReference Include="../CadSpace.Dxf/CadSpace.Dxf.csproj" />
    <PackageReference Include="Uno.WinUI.Graphics3DGL" Version="6.7.135" Condition="'$(TargetFramework)' == 'net10.0-browserwasm'" />
  </ItemGroup>
</Project>
