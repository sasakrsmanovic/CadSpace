<UserControl x:Class="CadSpace.Controls.CadLayerManager"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <DataTemplate x:Key="LayerRowTemplate">
            <Grid Height="30" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24"/><ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="42"/><ColumnDefinition Width="48"/>
                    <ColumnDefinition Width="90"/><ColumnDefinition Width="150"/><ColumnDefinition Width="60"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Current}" Foreground="#64B5F6" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="{Binding VisibilityText}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="3" Text="{Binding LockText}" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Rectangle Width="12" Height="12" Fill="{Binding Swatch}"/>
                    <TextBlock Text="{Binding ColorText}" FontSize="10"/>
                </StackPanel>
                <TextBlock Grid.Column="5" Text="{Binding Linetype}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="6" Text="{Binding Weight}" VerticalAlignment="Center"/>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>
    <Grid RowSpacing="10" Width="810" Height="470">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBox x:Name="Search" PlaceholderText="Search layer names" FontSize="12" MinHeight="30" TextChanged="OnSearch"/>
        <Grid Grid.Row="1" ColumnSpacing="8" Margin="12,0,0,0" Opacity="0.65">
            <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="200"/><ColumnDefinition Width="42"/><ColumnDefinition Width="48"/><ColumnDefinition Width="90"/><ColumnDefinition Width="150"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
            <TextBlock Text="✓"/><TextBlock Grid.Column="1" Text="Name"/><TextBlock Grid.Column="2" Text="On"/><TextBlock Grid.Column="3" Text="Lock"/><TextBlock Grid.Column="4" Text="Color"/><TextBlock Grid.Column="5" Text="Linetype"/><TextBlock Grid.Column="6" Text="Weight"/>
        </Grid>
        <ListView x:Name="Layers" Grid.Row="2" FontSize="11" SelectionMode="Single" SelectionChanged="OnSelected" ItemTemplate="{StaticResource LayerRowTemplate}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8">
            <TextBox x:Name="NewName" PlaceholderText="New layer name" Width="230" FontSize="12"/>
            <Button Content="New layer" Click="OnAdd"/><Button Content="Set current" Click="OnCurrent"/><Button Content="Delete empty" Click="OnDelete"/>
        </StackPanel>
        <Grid Grid.Row="4" ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="90"/><ColumnDefinition Width="150"/><ColumnDefinition Width="64"/><ColumnDefinition Width="76"/><ColumnDefinition Width="76"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBox x:Name="LayerName" Header="Name" FontSize="11"/>
            <TextBox x:Name="ColorValue" Grid.Column="1" Header="RGB" FontSize="11"/>
            <ComboBox x:Name="LineType" Grid.Column="2" Header="Linetype" FontSize="11" HorizontalAlignment="Stretch"/>
            <TextBox x:Name="WeightValue" Grid.Column="3" Header="Weight" FontSize="11"/>
            <CheckBox x:Name="Visible" Grid.Column="4" Content="On" VerticalAlignment="Bottom" FontSize="11"/>
            <CheckBox x:Name="Locked" Grid.Column="5" Content="Lock" VerticalAlignment="Bottom" FontSize="11"/>
            <Button Grid.Column="6" Content="Apply" VerticalAlignment="Bottom" Click="OnApply"/>
        </Grid>
        <TextBlock x:Name="Status" Grid.Row="5" FontSize="11" TextWrapping="Wrap" Foreground="#9AA8BA"/>
    </Grid>
</UserControl>
